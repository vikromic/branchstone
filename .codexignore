# ============================================================
# Universal .codexignore — AI/LLM context exclusions
# Covers: Python, Java/Spring, Node/TS, Angular, React, Vue,
#         Go, Rust, .NET, DevOps, mobile, and general tooling
# ============================================================

# =========================
# OS / Desktop junk
# =========================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
*.lnk
Icon?
._*

# =========================
# VCS / metadata
# =========================
.git/
.gitignore
.gitattributes
.gitmodules
.hg/
.hgignore
.svn/

# =========================
# IDE / Editor
# =========================
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*.tmp
*~
*.bak
*.orig
.project
.classpath
.settings/
.eclipseprojects
*.sublime-project
*.sublime-workspace
.vim/
.nvim/
tags
TAGS
*.code-workspace

