{
  "name": "branchstone-carried-ground",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0 --port 8082",
    "device:audit": "npm test && npm run build && npm run verify:artifact && node scripts/device-audit-server.mjs",
    "assets:gallery-previews": "node scripts/generate-artwork-previews.mjs",
    "assets:mobile-materials": "node scripts/generate-mobile-materials.mjs",
    "test": "vitest run",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir .stage-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "publish": "npm run build && npm run verify:artifact && node scripts/publish.mjs && npm run verify:published"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource/cormorant-garamond": "^5.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
