{
  "name": "branchstone",
  "version": "1.0.0",
  "description": "A minimalist, elegant artist portfolio website for mixed-media artist Viktoria Branchstone.",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --maxWorkers=2",
    "lint": "eslint docs/js/**/*.js",
    "lint:fix": "eslint docs/js/**/*.js --fix",
    "format": "prettier --write \"docs/js/**/*.{js,json}\"",
    "format:check": "prettier --check \"docs/js/**/*.{js,json}\"",
    "validate": "npm run lint && npm run format:check && npm run test:ci",
    "optimize-images": "cd scripts && npm install && npm run optimize",
    "build:css": "cd docs/css && cat 01-tokens.css 02-base.css 03-header.css 04-gallery.css 05-buttons.css 06-footer.css 07-utilities.css 08-hero.css 09-featured.css 10-about.css 11-contact.css 12-sections.css > bundle.css",
    "serve": "cd docs && python3 -m http.server 8000"
  },
  "keywords": [
    "portfolio",
    "art",
    "gallery",
    "artist-website"
  ],
  "author": "Viktoria Branchstone",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "babel-jest": "^30.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/username/branchstone.git"
  },
  "private": true
}
